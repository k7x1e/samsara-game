[sub_resource type="Resource" id="Resource_vl8n3"]
script = ExtResource("1_fdpo0")
dialogueText = "What i am about to tell you is very important so listen closely sir. If you manage to open a so called inventory(E or MMB) you can access your inventory. From there you can equip spells and vice versa. (n)\"In this game pretty much anything that is used in a sense is technically a spell\". (n)I was uninformed of what that last part meant but we all know you shalt figure it out.(n)Samsonarum is still very early on in development so expect the richness of content to be minimal. So long and goodbye."
dialogueOptions = Array[ExtResource("2_ros8p")]([SubResource("Resource_vu85i")])
questStatus = 3
quest = ExtResource("3_v8vff")
metadata/_custom_type_script = "uid://bg6c48acdck1"

