[sub_resource type="GDScript" id="GDScript_2tc6j"]
script/source = "extends Node3D

@export var duration = 10.0
@export var statusEffect: statuseffect

# Called when the node enters the scene tree for the first time.
func initialize() -> void:
	Globals.Player.modifyEffects(statusEffect, true)
	var backup = Globals.stats.agility
	Globals.stats.setstat(0,backup*2.0)
	var finalDuration = duration * (Globals.stats.magic * 0.75)
	statusEffect.duration=finalDuration
	statusEffect.initialize()
	await Engine.get_main_loop().create_timer(finalDuration).timeout
	Globals.Player.modifyEffects(statusEffect, false)
	Globals.stats.setstat(0,backup)
	self.queue_free()
"

[sub_resource type="GDScript" id="GDScript_aci0i"]
script/source = "extends Resource

class_name statuseffect

signal durationOver()

@export var icon: Texture
@export var Name: String
@export var active: bool = false

@export var timed: bool = false
@export var duration: float
@export var timeleft: float

var temptimer: Timer

func initialize():
	if timed:
		temptimer = Timer.new()
		Globals.effecthandler.add_child(temptimer)
		temptimer.start(duration)
		temptimer.timeout.connect(stop)

func tick():
	print(\"ticking effect\")
	timeleft = temptimer.time_left
	print(timeleft)

func stop():
	durationOver.emit()
"

