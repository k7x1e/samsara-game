[sub_resource type="GDScript" id="GDScript_tdvbi"]
script/source = "extends Control

@export var dialogueToUse: conversation
@export var index: int = 0

@onready var textNode = $VBoxContainer/Label
@onready var optionNode = $VBoxContainer/Options
@onready var option = preload(\"res://Scenes/dialogue_option.tscn\")

@onready var nameLabel = $VBoxContainer/name

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	Globals.dialogueMenu = self

func update():
	nameLabel.text = dialogueToUse.speakerName
	#print(\"updating dialogue\")
	for i in optionNode.get_children():
		i.queue_free()
	var currentW = dialogueToUse.manuscript[index]
	if currentW.isDialogue:
		textNode.text = currentW.dialogueText
		var b = 0
		#for name: String in names:
		for i: DialogueOption in currentW.dialogueOptions:
			var temp= option.instantiate()
			optionNode.add_child(temp)
			temp.text = i.text
			if i.fallbackTarget == -2 and !i.condition.fulfilled:
				temp.disabled = true
				if i.hide:
					temp.hide()
			temp.pressed.connect(optionPressed.bind(i))
			b += 1
		if currentW.questStatus != 0:
			print(currentW.questStatus)
			currentW.quest.setQuestState(currentW.questStatus)
			#i must say, this system is shit but damn if it isnt convenient to scale

func optionPressed(i: DialogueOption):
	if i.target == -1:
		Globals.Root.stopDialogue()
		return
	index = 3
	match i.condMode:
		1:
			match i.condition.fulfilled:
				true:
					index = i.target
				false:
					index = i.fallbackTarget
		0:
			match i.condition.fulfilled:
				true:
					index = i.fallbackTarget
				false:
					index = i.target
		-1:
			index = i.target
	update()
"

[sub_resource type="GDScript" id="GDScript_isjgb"]
script/source = "extends Resource

class_name dialogue

@export var isDialogue: bool = true
@export var dialogueText: String = \"PlaceHolder\"

@export var dialogueOptions: Array[DialogueOption]

@export var target: int

@export_enum(\"Unknown\", \"Given\",\"Achieved\",\"Completed\") var questStatus: int = 0## 0 means it doesnt, 1 means it discovers, 2 means it \"progresses\"(TBA), 3 means it achieves, 4 means it completes and 5 means it botches (fails)
@export var quest: Quest

@export var condition: Condition #not implemented yet
@export var condMode: int = -1 ##-1 nothing, 0 set to false, 1 set to true
"

[sub_resource type="GDScript" id="GDScript_81knq"]
script/source = "class_name DialogueOption
extends Resource

@export var text = \"Sample Text\"
@export var target: int
@export var requiresItem: bool
@export var requiredItem: Item
@export var takeItem: bool ## unsupported

@export var condition: Condition
@export var condMode: int = -1 ##-1 do nothing, 0 need false, 1 need true.
@export var fallbackTarget: int ##if condition failed go to this target instead.
@export var hide: bool = false ##If condition isnt met and the fallback is -2 this will determine whether the option is given to begin with.
"

