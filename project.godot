config_version=5

[application]

config/name="samsonarum"
config/version="alpha"
run/main_scene="uid://bjo1qm1kfwu2s"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.png"

[audio]

buses/default_bus_layout="uid://fbnk8rbwu1mp"

[autoload]

