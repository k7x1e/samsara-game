[sub_resource type="GDScript" id="GDScript_d458g"]
script/source = "extends Node3D

@export var activeLeftSpell: spell
@export var activeRightSpell: spell

@export var spells: Array[spell]

# Called when the node enters the scene tree for the first time.
func cast(which: int): #1: left, 2: right, 3,4,5: other bindable spells
	match which:
		1:
			activeLeftSpell.cast(self)
		_:
			#fuck you
			print(\"fuck you\")
"

[sub_resource type="GDScript" id="GDScript_msv0n"]
script/source = "extends Resource

class_name spell

@export var spellNode: PackedScene
@export var cost: float #WONT BE INTEGRATED FOR A WHILE

#not implemented yet
@export var name: String
@export var description: String
@export var Icon: Texture

func cast(caster: Variant):
	#Globals.Player
	var actualNode = spellNode.instantiate()
	Globals.Root.add_child(actualNode)
	actualNode.global_rotation = caster.global_rotation
	actualNode.global_position = caster.global_position
	actualNode.set_owner(Globals.Player)
"

[sub_resource type="GDScript" id="GDScript_hn5sb"]
script/source = "extends Node3D

@export var speed: float = 5.0

func _ready() -> void:
	print (\"hej\")

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	#do whatever, ill prioritize actual casting/using. (WEAPONS WILL WORK THE SAME AS SPELLS)
	# Get the forward direction based on current rotation
	var direction = -transform.basis.z
	
	# Set velocity and move
	var velocity = direction * speed
	position += velocity
"

