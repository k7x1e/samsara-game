[sub_resource type="Resource" id="Resource_d2j5p"]
script = ExtResource("1_sk76p")
dialogueText = "Oh indeed I may know of something. It would be customary of me to ask a favor to do such a thing but seeing as youre marked I won't. A ship came into port recently carrying all three scrolls, two of them were stolen by unknown actors but the first might just still be there. I'd advice against going there my friend."
dialogueOptions = Array[ExtResource("2_aupdi")]([SubResource("Resource_sk76p"), SubResource("Resource_aupdi")])
metadata/_custom_type_script = "uid://bg6c48acdck1"

