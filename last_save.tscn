[sub_resource type="GDScript" id="GDScript_6x0bu"]
script/source = "extends HBoxContainer

@onready var spell1 = $Spell1
@onready var spell2 = $Spell2
@onready var spell3 = $Spell3
@onready var spell4 = $Spell4
@onready var spell5 = $Spell5

@onready var spells: Array[Node] = [$Spell1,$Spell2,$Spell3,$Spell4,$Spell5]
var spellArray: Array[spell] = []

func update():
	updateSpells(spellArray)

func _ready() -> void:
	Globals.spellMaster = self

func updateSpells(spellList: Array[spell]):
	spellArray = spellList
	for i in range(spellList.size()):
		updateSpell(spells[i], spellList[i])

func updateSpell(spellNode: Node, spel: spell):
	#print(\"updated spell\")
	spellNode.spel = spel
	spellNode.iconNode.texture = spel.Icon
	spellNode.dim.max_value = spel.coolDown
	spellNode.timer_active = spel.cooldown_active
	match spel.cooldown_active:
		true:
			#print(\"showing dim\")
			spellNode.dim.show()
		false:
			#print(\"hiding dim\")
			spellNode.dim.hide()
	spel.uiNode = spellNode
	match spel.limited:
		false:
			spellNode.costLabel.text = str(spel.cost)
		true:
			spellNode.costLabel.text = str(spel.quantity)
	if spel.isPlaceHolder:
		spellNode.costLabel.text = \"\"
	spel.updateStats()
"

[sub_resource type="GDScript" id="GDScript_r65kv"]
script/source = "extends Control

@onready var iconNode = $spellIcon
@onready var dim = $Dimmin
@onready var timerNode = $Timer
@onready var costLabel = $Label

@export var spel: spell

@export var timer_active: bool = false

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func tick():
	if timer_active:
		dim.value = spel.spellTimer.wait_time - spel.spellTimer.time_left


func _on_timer_timeout() -> void:
	timer_active = false
"

