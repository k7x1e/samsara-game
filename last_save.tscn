[sub_resource type="GDScript" id="GDScript_yek4i"]
script/source = "extends GridContainer

@onready var window = get_node(\"../../../\")
@onready var itemNode = preload(\"res://Scenes/item.tscn\")

var dropDownNode: Node

@export var theInventory: InventoryClass

var dragging: bool = false
var draggingNode: Node
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	Globals.inventory = self
	await get_tree().create_timer(0.01).timeout
	dropDownNode = Globals.menu.dropdown


func initialize():
	await updateInventory()
	#genuinely evil strat, for some reason it has some weird sorting algorithm thingy so this should fix it. adjust the value if the player would for some reason start out with a huge inventory
	for i in range(1,100):
		await checkColumns()
		window.size = window.custom_minimum_size
		self.size = window.custom_minimum_size

func updateInventory():
	print(\"updating inventory\")
	flush()
	theInventory = Globals.Player.inventory
	for i in range(theInventory.inventory.size()):
		var temp = itemNode.instantiate()
		self.add_child(temp)
		temp.set_owner(self)
		temp.initialize(theInventory.inventory[i])
		
	#check players inventory, 

func checkColumns():
	var columns = int(self.size.x / 148)
	self.set_columns(columns)
	var tempsizeY = int((theInventory.inventory.size()/2)+1) * 148
	var tempsizeX = int(sqrt(theInventory.inventory.size())+1) * 148
	print(tempsizeX)
	var minimumsize: Vector2 = Vector2(tempsizeX, tempsizeX + 26)
	window.custom_minimum_size = minimumsize

func flush():
	for n in self.get_children():
		self.remove_child(n)
		n.queue_free()

func pickup(what: Node):
	if !dragging:
		var pickedItem = what.ownItem
		theInventory.remove(pickedItem)
		remove_child(what)
		Globals.menu.add_child(what)
		what.dragging = true
		unequip(what)
		dragging = true
		draggingNode = what
		updateInventory()
		print(\"picked up a \", what.ownItem.name)

func unequip(what: Node):
	what.ownItem.equipped = false
	what.checkBorder()
	match what.ownItem.Type:
		\"Spell\":
			Globals.wizard.remove(Globals.wizard.spells.find(what.ownItem.theSpell))
			Globals.spellMaster.updateSpells(Globals.wizard.spells)
		_:
			pass

func _gui_input(event: InputEvent) -> void:
	#checkColumns()
	if event.is_action_pressed(\"LeftClick\"):
		stopDragging()

func stopDragging():
	if dragging:
		var itembackup = draggingNode.ownItem
		draggingNode.queue_free()
		theInventory.add(itembackup)
		updateInventory()
		dragging = false

func dropDown(nodeinquestion: Node):
	#replace with a neat function
	dropDownNode.show()
	dropDownNode.global_position = get_global_mouse_position()
	dropDownNode.updateItem(nodeinquestion)
"

[sub_resource type="GDScript" id="GDScript_7t33b"]
script/source = "extends Control

@onready var equipB = $VBoxContainer/equip
@onready var unEquipB = $VBoxContainer/unequip

@onready var assign1 = $VBoxContainer/assign1
@onready var assign2 = $VBoxContainer/assign2
@onready var assign3 = $VBoxContainer/assign3
@onready var assign4 = $VBoxContainer/assign4
@onready var assign5 = $VBoxContainer/assign5
@onready var unassign = $VBoxContainer/unassign

@export var currentItem: Node

func updateItem(iteminQ: Node):
	currentItem = iteminQ
	var tempitem = currentItem.ownItem
	match tempitem.Type:
		\"Spell\":
			equipButtons(true)
			assignButtons(false)
		\"Item\":
			equipButtons(true)
			assignButtons(true)
	if tempitem.equippable:
		equipButtons(false)
	if tempitem.equipped and tempitem.equippable:
		unEquipB.disabled = false
			
func equipButtons(disableD: bool):
	equipB.disabled = disableD
	unEquipB.disabled = true

func assignButtons(disableD: bool):
	assign1.disabled = disableD
	assign2.disabled = disableD
	assign3.disabled = disableD
	assign4.disabled = disableD
	assign5.disabled = disableD
	unassign.disabled = disableD

func close():
	self.hide()

#assigning section
func assignSpell(which: int):
	var itemInQ = currentItem.ownItem
	if itemInQ.Type == \"Spell\":
		if Globals.wizard.spells.has(itemInQ.theSpell):
			#oh my god
			Globals.wizard.remove(Globals.wizard.spells.find(itemInQ.theSpell))
		Globals.wizard.spells[which] = itemInQ.theSpell
		Globals.spellMaster.updateSpells(Globals.wizard.spells)
		itemInQ.equipped = true
		currentItem.checkBorder()

func _on_assign_1_pressed() -> void:
	assignSpell(0)
	close()


func _on_assign_2_pressed() -> void:
	assignSpell(1)
	close()


func _on_assign_3_pressed() -> void:
	assignSpell(2)
	close()


func _on_assign_4_pressed() -> void:
	assignSpell(3)
	close()


func _on_assign_5_pressed() -> void:
	assignSpell(4)
	close()

func _on_unassign_pressed() -> void:
	Globals.inventory.unequip(currentItem)
	close()

#equipping

func _on_equip_pressed() -> void:
	pass # Replace with function body.

func _on_unequip_pressed() -> void:
	pass # Replace with function body.

#etcetera

func _on_close_pressed() -> void:
	close()


func _on_discard_pressed() -> void:
	Globals.Player.inventory.remove(currentItem.ownItem)
	Globals.inventory.updateInventory()
	close()
"

